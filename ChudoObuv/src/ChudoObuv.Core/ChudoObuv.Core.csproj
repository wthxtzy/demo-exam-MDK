<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChudoObuv.Core</RootNamespace>
    <AssemblyName>ChudoObuv.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\database\schema.sql" LogicalName="ChudoObuv.Core.schema.sql" />
    <EmbeddedResource Include="..\..\database\seed.sql" LogicalName="ChudoObuv.Core.seed.sql" />
  </ItemGroup>

</Project>
